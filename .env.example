POSTGRES_DB=liftmetrics
POSTGRES_USER=liftmetrics
POSTGRES_PASSWORD=replace-with-a-local-secret
DATABASE_URL=postgresql://liftmetrics:replace-with-a-local-secret@db:5432/liftmetrics?schema=public
PORT=3000
NODE_ENV=development

# Auth0 user authentication
# AUTH0_ISSUER must end with a trailing slash.
AUTH0_ISSUER=
# Must exactly match the Identifier configured for the LiftMetrics API in Auth0.
AUTH0_API_AUDIENCE=
# Comma-separated Auth0 Client IDs allowed to request user tokens for this API.
AUTH0_CLIENT_IDS=
# Auth0 Single Page Application client ID passed to the public frontend build.
# Optional when AUTH0_CLIENT_IDS contains exactly one ID. Set explicitly when
# the allowlist contains multiple clients.
AUTH0_SPA_CLIENT_ID=

# Auth0 Management API credentials for deleting identities during account deletion.
# Keep the real client secret in your untracked .env file; never commit it.
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
# Must exactly match the Auth0 Management API Identifier.
AUTH0_MGMT_AUDIENCE=
